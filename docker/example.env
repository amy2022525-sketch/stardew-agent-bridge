# Non-secret settings. Copy to a private file; pass its absolute path with --env-file.
SAB_HTTP_PORT=18055
SAB_PUBLIC_BASE_URL=http://127.0.0.1:18055
SAB_UID=1000
SAB_GID=1000
SAB_IMAGE_PREFIX=local/stardew-agent-bridge
SAB_LOG_LEVEL=info
SAB_STARTUP_TIMEOUT_MS=180000
SAB_SHUTDOWN_TIMEOUT_MS=35000
SAB_DISPLAY_SIZE=1280x720
# Full game mode requires Linux-native game + installed SMAPI; Windows files are unsuitable.
# SAB_GAME_SOURCE=/absolute/private/linux-game-with-smapi
# Optional noVNC: exactly 8 ASCII letters/digits, stored in a private file, never here.
SAB_NOVNC_PORT=6080
# SAB_DESKTOP_BASE_URL=http://127.0.0.1:6080
# SAB_VNC_PASSWORD_PATH=/absolute/private/vnc-password
