{
  "name": "stardew-agent-bridge",
  "version": "0.2.0-preview.1",
  "private": true,
  "description": "星露谷本机 SMAPI 桥接 + Web 控制台 + MCP 服务：让支持 MCP 的本地 Agent 观察和游玩星露谷。",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*",
    "apps/server",
    "apps/web",
    "adapters/*",
    "tests"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "build:mod": "node scripts/build-mod.mjs",
    "typecheck": "node scripts/build.mjs --check-only",
    "test": "node scripts/test.mjs",
    "test:mod": "dotnet run --project tests/mod/ControlTests.csproj",
    "test:installer": "node scripts/test-installer.mjs",
    "test:unit": "node --test \"tests/dist/**/*.test.js\"",
    "start": "node apps/server/dist/cli.js start",
    "launch": "node apps/server/dist/cli.js launch",
    "doctor": "node apps/server/dist/cli.js doctor",
    "pack": "node scripts/pack.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "docker:bundle": "node scripts/docker/build.mjs --bundle",
    "docker:build": "node scripts/docker/build.mjs --target bridge-runtime",
    "docker:inspect": "node scripts/docker/inspect-image.mjs",
    "docker:manage": "node scripts/docker/manage.mjs",
    "install:mod": "node scripts/install-mod.mjs",
    "rollback:mod": "node scripts/rollback-mod.mjs",
    "desktop": "node scripts/linux/desktop-entry.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "ajv": "8.20.0",
    "ws": "8.22.0"
  }
}
